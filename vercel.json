{
  "version": 2,
  "builds": [
    {
      "src": "server.ts",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server.ts" },
    { "src": "/admin",    "dest": "/public/index.html" },
    { "src": "/(.*\\.(html|css|js|ico|png|jpg|svg))", "dest": "/public/$1" },
    { "src": "/(.*)",     "dest": "server.ts" }
  ]
}
