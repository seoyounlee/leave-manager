{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["server.ts", "data-handler.ts", "db.ts", "gcal.ts"],
  "exclude": ["node_modules", "dist", "prisma.config.ts"]
}
