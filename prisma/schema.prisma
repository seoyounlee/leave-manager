generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Employee {
  id              String          @id @default(cuid())
  name            String
  department      String          @default("")
  password        String?
  memo            String?
  joinedAt        DateTime
  status          EmployeeStatus  @default(ACTIVE)
  promotionStatus PromotionStatus @default(NONE)
  resignedAt      DateTime?
  createdAt       DateTime        @default(now())
  totalDays       Float           @default(0)
  leaveYears      LeaveYear[]
  requests        LeaveRequest[]
  promotions      LeavePromotion[]
}

enum EmployeeStatus {
  ACTIVE
  RESIGNED
}

enum PromotionStatus {
  NONE
  FIRST_DONE
  SECOND_DONE
}

model LeaveYear {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String
  year       Int
  totalDays  Float
  usedDays   Float    @default(0)
  carryOver  Float    @default(0)
  note       String?
  createdAt  DateTime @default(now())

  @@unique([employeeId, year])
}

model LeaveRequest {
  id         String    @id @default(cuid())
  employee   Employee  @relation(fields: [employeeId], references: [id])
  employeeId String
  date       String
  type       LeaveType
  days       Float     @default(1)
  year       Int
  reason     String
  status     Status    @default(PENDING)
  reviewNote String?
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
}

model LeavePromotion {
  id          String    @id @default(cuid())
  employee    Employee  @relation(fields: [employeeId], references: [id])
  employeeId  String
  year        Int
  round       Int
  snapshot    String
  adminNote   String?
  sentAt      DateTime  @default(now())
  confirmedAt DateTime?
}

enum LeaveType {
  FULL
  HALF_AM
  HALF_PM
  TIME_1H
  TIME_2H
  TIME_3H
  SUPPORT_2H
}

enum Status {
  PENDING
  APPROVED
  REJECTED
}
